# Copy to .env for local dev. Real secrets are stored in the OS keychain at
# runtime (see SecretsPort); this file is only a dev convenience / documentation.

# OpenRouter API key (https://openrouter.ai/keys). In production this is read
# from the OS keychain via the secrets adapter, NOT from env.
VITE_OPENROUTER_API_KEY=

# Optional: default model route override (OpenRouter model slug).
VITE_DEFAULT_MODEL=anthropic/claude-haiku-4.5 # anthropic/claude-haiku-4.5
VITE_DEFAULT_MODEL_VISION=google/gemini-3.1-flash-lite
VITE_DEFAULT_MODEL_REASONING=google/gemini-3.1-flash-lite
VITE_DEFAULT_MODEL_CODING=google/gemini-3.1-flash-lite




# Global hotkeys (Electron/Tauri accelerator syntax). Optional — falls back to
# the defaults below when unset.
VITE_TOGGLE_HUD_ACCELERATOR=CommandOrControl+Shift+Space
VITE_SCREENSHOT_ACCELERATOR=CommandOrControl+Alt+S