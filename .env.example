# Copy to .env for local dev. Real secrets are stored in the OS keychain at
# runtime (see SecretsPort); this file is only a dev convenience / documentation.

# OpenRouter API key (https://openrouter.ai/keys). In production this is read
# from the OS keychain via the secrets adapter, NOT from env.
VITE_OPENROUTER_API_KEY=

# Optional: primary model tried first (OpenRouter model slug). Falls back to the
# compiled-in default when unset.
VITE_DEFAULT_MODEL=anthropic/claude-haiku-4.5

# Optional: ordered failover chain (comma-separated). When the primary — or a
# prior fallback — fails with a retryable/provider-side error (model
# unavailable, 429/5xx, network), the next model is tried, in order. Spread
# across providers so one provider's outage doesn't take the app down. May
# repeat the primary (deduped automatically).
#
# IMPORTANT: the main scenario always sends a screenshot, so every model here
# must be MULTIMODAL. deepseek/deepseek-v4-flash is TEXT-ONLY — only add it if
# you use text-only prompts; it will reject image requests.
VITE_MODEL_FALLBACKS=google/gemini-3.1-flash-lite,openai/gpt-4o-mini




# Global hotkeys (Electron/Tauri accelerator syntax). Optional — falls back to
# the defaults below when unset.
VITE_TOGGLE_HUD_ACCELERATOR=CommandOrControl+Shift+Space
# Capture a screenshot into the batch (phase 8) — stages 1–5 shots, does not analyze.
VITE_CAPTURE_ACCELERATOR=CommandOrControl+Alt+S
# Send the staged screenshot batch for analysis and stream the answer.
VITE_SEND_ACCELERATOR=CommandOrControl+Alt+Enter
# Toggle loopback audio recording (phase 9) — captures the output device
# (interlocutor's voice); transcribed and attached to the batch on send.
VITE_RECORD_ACCELERATOR=CommandOrControl+Alt+L